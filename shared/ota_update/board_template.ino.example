// board_template.ino.example
//
// Starting point for a new CYD board sketch: WiFi setup (WiFiManager) ->
// OTA update check -> on-device mode picker -> mode dispatch.
//
// To start a new board:
//   1. Copy this file into espProjects/<board_name>/<board_name>.ino
//   2. Copy shared/ota_update/ota_update.h into the same folder
//   3. Set BOARD_NAME and FW_VERSION_CODE below
//   4. Add a mode_<name>.h per mode (see the two stubs below) and register
//      it in setupModes()/loopMode()
//   5. In Arduino IDE: Tools > Partition Scheme, pick an OTA-capable scheme
//      (see shared/ota_update/README.md — this is a per-machine manual step)

#include <WiFi.h>
#include <WiFiManager.h>
#include <WebServer.h>
#include <Preferences.h>
#include <TFT_eSPI.h>

#define BOARD_NAME "BoardTemplate"      // AP name becomes "<BOARD_NAME>-Setup"
#define FW_VERSION_CODE 10000            // v1.0.0 — bump on every release

#include "ota_update.h"

TFT_eSPI tft = TFT_eSPI();
WiFiManager wifiManager;
WebServer modeServer(80);
Preferences prefs;

unsigned long lastOtaCheck = 0;

// ---- Modes -----------------------------------------------------------
// Each mode gets its own header with setup_<mode>() / loop_<mode>().
// Real boards: replace these two stubs with e.g. mode_subway.h, mode_surf.h.

enum BoardMode { MODE_NONE = 0, MODE_DEMO_A = 1, MODE_DEMO_B = 2 };

void setup_demoA() { tft.fillScreen(TFT_BLACK); tft.setCursor(10, 10); tft.println("Mode: Demo A"); }
void loop_demoA() {}

void setup_demoB() { tft.fillScreen(TFT_BLACK); tft.setCursor(10, 10); tft.println("Mode: Demo B"); }
void loop_demoB() {}

BoardMode activeMode = MODE_NONE;

void showMessage(const char* line1, const char* line2) {
  tft.fillScreen(TFT_BLACK);
  tft.setCursor(10, 10);
  tft.println(line1);
  tft.setCursor(10, 30);
  tft.println(line2);
}

// ---- Mode picker web UI ----------------------------------------------

void handleModeRoot() {
  String page = "<html><body><h2>" BOARD_NAME "</h2><ul>"
                "<li><a href=\"/set?mode=1\">Demo A</a></li>"
                "<li><a href=\"/set?mode=2\">Demo B</a></li>"
                "</ul></body></html>";
  modeServer.send(200, "text/html", page);
}

void handleModeSet() {
  int mode = modeServer.arg("mode").toInt();
  prefs.begin("board", false);
  prefs.putInt("mode", mode);
  prefs.end();
  modeServer.send(200, "text/html", "Mode saved. Rebooting...");
  delay(500);
  ESP.restart();
}

void dispatchMode(BoardMode mode) {
  switch (mode) {
    case MODE_DEMO_A: setup_demoA(); break;
    case MODE_DEMO_B: setup_demoB(); break;
    default: showMessage("No mode set", "Visit device IP to pick one"); break;
  }
}

void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);

  wifiManager.setAPCallback([](WiFiManager*) {
    showMessage("Connect to WiFi:", BOARD_NAME "-Setup");
  });
  if (!wifiManager.autoConnect(BOARD_NAME "-Setup")) {
    ESP.restart();
  }

  showMessage("Checking for", "updates...");
  checkForOTAUpdate(showMessage);  // reboots device in-place if an update is applied

  prefs.begin("board", true);
  int savedMode = prefs.getInt("mode", MODE_NONE);
  prefs.end();
  activeMode = (BoardMode)savedMode;

  modeServer.on("/", handleModeRoot);
  modeServer.on("/set", handleModeSet);
  modeServer.begin();

  dispatchMode(activeMode);
}

void loop() {
  modeServer.handleClient();

  if (millis() - lastOtaCheck >= OTA_CHECK_INTERVAL_MS) {
    lastOtaCheck = millis();
    checkForOTAUpdate(showMessage);
  }

  switch (activeMode) {
    case MODE_DEMO_A: loop_demoA(); break;
    case MODE_DEMO_B: loop_demoB(); break;
    default: break;
  }
}
