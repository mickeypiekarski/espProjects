// board_template.ino.example
//
// Starting point for a new STANDALONE board-type sketch: WiFi setup
// (WiFiManager) -> OTA update check (scoped to this board's own release
// asset) -> board logic.
//
// This produces ONE STANDALONE BINARY for one board type — not a picker with
// multiple modes baked in. A friend chooses their board type once, via the
// installer/ sketch's web picker, which downloads and flashes the matching
// named .bin. Boards never contain code for board types they aren't running.
//
// To start a new board type:
//   1. Copy this file into espProjects/<board_name>/<board_name>.ino
//      (e.g. espProjects/surf_board/surf_board.ino)
//   2. Copy shared/ota_update/ota_update.h into the same folder
//   3. Set BOARD_NAME, MDNS_HOSTNAME, FW_VERSION_CODE (start at 10000 for
//      v1.0.0), and BOARD_ASSET_NAME below. Convention: BOARD_ASSET_NAME is
//      "<board_name>.bin", matching the folder/sketch name.
//   4. Replace setupBoard()/loopBoard() with your board's real logic (web
//      UI for any on-device config it needs, Preferences for persisted
//      state, whatever the board actually does).
//   5. In Arduino IDE: Tools > Partition Scheme, pick an OTA-capable scheme
//      (see shared/ota_update/README.md — this is a per-machine manual step)
//   6. When cutting a release: export this board's .bin, attach it under
//      BOARD_ASSET_NAME, and add/update an entry for it in that release's
//      manifest.json so it's selectable from the installer. See
//      shared/ota_update/README.md for the full release-cutting steps.
//      NOTE: this is a manifest.json update, not an installer re-flash —
//      installers already out in the field pick up new board types
//      automatically the next time someone loads their picker page.

#include <WiFi.h>
#include <WiFiManager.h>
#include <WebServer.h>
#include <Preferences.h>
#include <TFT_eSPI.h>
#include <ESPmDNS.h>

#define BOARD_NAME "BoardTemplate"        // AP name becomes "<BOARD_NAME>-Setup"
#define MDNS_HOSTNAME "boardtemplate"      // reachable at http://<MDNS_HOSTNAME>.local — lowercase, no spaces
#define FW_VERSION_CODE 10000              // v1.0.0 — bump on every release
#define BOARD_ASSET_NAME "boardtemplate.bin"  // matches the .bin name attached to releases

#include "ota_update.h"

TFT_eSPI tft = TFT_eSPI();
WiFiManager wifiManager;
WebServer webServer(80);
Preferences prefs;

unsigned long lastOtaCheck = 0;

void showMessage(const char* line1, const char* line2) {
  tft.fillScreen(TFT_BLACK);
  tft.setCursor(10, 10);
  tft.println(line1);
  tft.setCursor(10, 30);
  tft.println(line2);
}

// ---- Replace these with your board's actual logic ----------------------
// Real boards: draw something, register any web routes this board needs
// (e.g. a config picker like subway_board's station list) before
// webServer.begin() runs in setup(), and read/write Preferences under a
// namespace scoped to this board.

void setupBoard() {
  tft.fillScreen(TFT_BLACK);
  tft.setCursor(10, 10);
  tft.println("Hello, " BOARD_NAME);
}

void loopBoard() {}

// --------------------------------------------------------------------------

void setup() {
  Serial.begin(115200);
  Serial.printf("Running FW_VERSION_CODE: %d\n", FW_VERSION_CODE);
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);

  wifiManager.setAPCallback([](WiFiManager*) {
    showMessage("Connect to WiFi:", BOARD_NAME "-Setup");
  });
  if (!wifiManager.autoConnect(BOARD_NAME "-Setup")) {
    ESP.restart();
  }

  if (MDNS.begin(MDNS_HOSTNAME)) {
    Serial.printf("mDNS ready: http://%s.local\n", MDNS_HOSTNAME);
    MDNS.addService("http", "tcp", 80);
  } else {
    Serial.println("mDNS setup failed — fall back to IP from Serial output");
  }

  showMessage("Checking for", "updates...");
  checkForOTAUpdate(BOARD_ASSET_NAME, showMessage);  // reboots device in-place if an update is applied

  webServer.begin();

  setupBoard();
}

void loop() {
  webServer.handleClient();

  if (millis() - lastOtaCheck >= OTA_CHECK_INTERVAL_MS) {
    lastOtaCheck = millis();
    checkForOTAUpdate(BOARD_ASSET_NAME, showMessage);
  }

  loopBoard();
}
